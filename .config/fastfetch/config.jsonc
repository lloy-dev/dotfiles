{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    // "uptime",
    "packages",
    // "shell",
    "display",
    // "de",
    // "wm",
    // "wmtheme",
    // "theme",
    // "icons",
    // "font",
    // "cursor",
    // "terminal",
    "terminalfont",
    "break",
    // "cpu",
    {
        "type": "cpu",
        "temp": true
    },
    "cpuusage",
    // "gpu",
    {
        "type": "gpu",
        "temp": true
    },
    "memory",
    "swap",
    "break",
    "disk",
    // "localip",
    "battery",
    "poweradapter",
    // "locale",
    // "break",
    // "colors"
  ],
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/tifa.txt",
    "color": {
      "1": "white",
      "2": "red"
    }
  },
  "display": {
    "color": {
      "keys": "red",
      "title": "red",
      "output": "white"
    }
  }
}
